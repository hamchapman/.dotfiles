#!/usr/bin/env bash
# Delete local branches merged into the primary branch, preserving primary and
# checked-out branches. Git's -d also checks each branch's upstream.
set -euo pipefail
if git show-ref --verify --quiet refs/heads/main; then
  base=main
elif git show-ref --verify --quiet refs/heads/master; then
  base=master
else
  echo 'No local main or master branch; refusing to prune.' >&2
  exit 1
fi
current=$(git symbolic-ref --quiet --short HEAD || true)
while IFS= read -r branch; do
  case "$branch" in "$base"|main|master|dev|"$current") continue ;; esac
  git branch -d -- "$branch" || echo "Kept $branch (checked out or not merged into its upstream)." >&2
done < <(git for-each-ref --merged="$base" --format='%(refname:short)' refs/heads)
