#!/usr/bin/env bash
# Source this script to change directory into the new worktree.
_worktree_main() {
    local verbose='' branchname dirname root target f relative
    if [[ ${1:-} == -v || ${1:-} == --verbose ]]; then verbose=1; shift; fi
    if [[ ${1:-} == -h || ${1:-} == --help ]]; then
        printf 'Usage: worktree [-v] <branch-name>\n'
        return 0
    fi
    if [[ $# != 1 ]]; then
        printf 'Usage: worktree [-v] <branch-name>\n'
        return 1
    fi
    branchname=$1
    git check-ref-format --branch "$branchname" >/dev/null || return 1
    root=$(git rev-parse --show-toplevel) || return 1
    root=$(cd "$root" && pwd -P) || return 1
    dirname=${branchname//\//_}
    target="$(dirname "$root")/$dirname"
    [[ -n "$verbose" ]] && printf 'Creating %s at %s\n' "$branchname" "$target"

    if git -C "$root" show-ref --verify --quiet "refs/heads/$branchname" ||
       git -C "$root" show-ref --verify --quiet "refs/remotes/origin/$branchname"; then
        git -C "$root" worktree add "$target" "$branchname" || return 1
    else
        git -C "$root" worktree add -b "$branchname" "$target" || return 1
    fi

    # Copy only untracked matching files, never overwriting a target branch file.
    while IFS= read -r -d '' f; do
        relative=${f#"$root"/}
        if git -C "$root" ls-files --error-unmatch -- "$relative" >/dev/null 2>&1; then continue; fi
        if [[ -e "$target/$relative" || -L "$target/$relative" ]]; then
            printf 'Keeping existing %s\n' "$relative" >&2
            continue
        fi
        mkdir -p "$(dirname "$target/$relative")" || return 1
        cp -p "$f" "$target/$relative" || return 1
    done < <(find -E "$root" -type d \( -name .git -o -name node_modules \) -prune -o \
      -type f -iregex '.*/\.(envrc|env|env.local|tool-versions|mise.toml)' -print0)

    if [[ -f "$target/.envrc" ]]; then
        printf 'Review .envrc and run direnv allow if you trust it.\n'
    fi
    cd "$target" || return 1
    printf 'Created worktree %s\n' "$target"
}
_worktree_main "$@"
