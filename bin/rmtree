#!/usr/bin/env bash
# Remove linked worktrees safely; preserve unmerged branches and dirty trees.
set -euo pipefail
main_dir=${MAIN_BRANCH:-main}
while (($#)); do
  case "$1" in
    -h|--help) echo 'Usage: rmtree [-m main-directory] <worktree-directory>...'; exit 0 ;;
    -m|--main-branch) [[ $# -ge 2 ]] || { echo 'Missing -m value' >&2; exit 1; }; main_dir=$2; shift 2 ;;
    -v|--verbose) set -x; shift ;;
    --) shift; break ;;
    -*) echo "Unknown option: $1" >&2; exit 1 ;;
    *) break ;;
  esac
done
(($#)) || { echo 'Specify at least one worktree directory.' >&2; exit 1; }
if [[ ! -d "$main_dir" && "$main_dir" == main && -d master ]]; then main_dir=master; fi
[[ -d "$main_dir" ]] || { echo "Main directory not found: $main_dir" >&2; exit 1; }
main_dir=$(cd "$main_dir" && pwd -P)
git -C "$main_dir" rev-parse --git-dir >/dev/null
result=0
for target in "$@"; do
  if [[ ! -d "$target" ]]; then echo "Directory not found: $target" >&2; result=1; continue; fi
  target=$(cd "$target" && pwd -P)
  if [[ "$target" == "$main_dir" ]]; then echo "Refusing to remove main directory: $target" >&2; result=1; continue; fi
  found=0
  while IFS= read -r -d '' entry; do
    [[ "$entry" == "worktree $target" ]] && found=1
  done < <(git -C "$main_dir" worktree list --porcelain -z)
  if (( ! found )); then echo "Not a worktree in this repository: $target" >&2; result=1; continue; fi
  branch=$(git -C "$target" symbolic-ref --quiet --short HEAD || true)
  if [[ "$branch" == main || "$branch" == master ]]; then
    echo "Refusing to remove primary branch worktree: $target" >&2; result=1; continue
  fi
  if ! git -C "$main_dir" worktree remove -- "$target"; then result=1; continue; fi
  if [[ -n "$branch" ]]; then
    if git -C "$main_dir" merge-base --is-ancestor "$branch" HEAD; then
      git -C "$main_dir" branch -d -- "$branch" || { echo "Kept branch $branch." >&2; result=1; }
    else
      echo "Kept branch $branch: it is not merged into the main worktree's HEAD."
    fi
  fi
done
exit "$result"
