setopt localoptions promptsubst

export EDITOR='zed --wait'
export GOPATH="$HOME/go"
export GEM_HOME="$HOME/.gem"
export DEFAULT_STABLE_RUBY="3.4.4"
export JAVA_HOME="/Applications/Android Studio.app/Contents/jbr/Contents/Home"
export ANDROID_HOME="$HOME/Library/Android/sdk"

# Load files. brew.zsh and path.zsh must load first: several other files
# (e.g. history.zsh's fzf detection) depend on PATH already including
# Homebrew's bin dir. On a fresh login shell, macOS's path_helper resets
# PATH to just the system defaults, so without this explicit ordering,
# anything relying on Homebrew-installed tools being found during the
# alphabetical *.zsh load would silently fail to detect them.
source $HOME/.dotfiles/zsh/brew.zsh
source $HOME/.dotfiles/zsh/path.zsh
for file ($HOME/.dotfiles/zsh/*.zsh); do
  case "$file" in
    */brew.zsh|*/path.zsh) continue ;;
  esac
  source $file
done

REPORTTIME=10 # print elapsed time when command runs for more than 10 seconds

# make GPG stuff work
GPG_AGENT_SOCKET="$(gpgconf --list-dirs agent-ssh-socket)"
if [ ! -S $GPG_AGENT_SOCKET ]; then
  gpg-agent --daemon --pinentry-program "${BREW_PREFIX}/bin/pinentry-mac" >/dev/null 2>&1
  export GPG_TTY=$(tty)
fi

## Randoms

ulimit -n 65536

eval "$(direnv hook zsh)"
(( $+commands[mise] )) && eval "$(mise activate zsh)"

# Load NVM lazily. Sourcing nvm.sh normally also auto-activates the default
# (or .nvmrc) Node version right away, which means resolving/verifying a
# Node install on *every* shell start. `--no-use` skips that and just
# defines `nvm` + completions (~5ms). To keep `node`/`npm`/`npx`/`nvm`
# working transparently, stub them so the real environment (respecting
# .nvmrc, falling back to the default alias) is loaded on first actual use.
export NVM_DIR="$HOME/.nvm"
if [ -s "${BREW_PREFIX}/opt/nvm/nvm.sh" ]; then
  . "${BREW_PREFIX}/opt/nvm/nvm.sh" --no-use

  load_nvm() {
    unset -f node npm npx nvm load_nvm
    export NVM_DIR="$HOME/.nvm"
    . "${BREW_PREFIX}/opt/nvm/nvm.sh"
    if [ -f .nvmrc ]; then
      nvm use
    else
      nvm use default
    fi
  }

  node() { load_nvm; node "$@" }
  npm() { load_nvm; npm "$@" }
  npx() { load_nvm; npx "$@" }
  nvm() { load_nvm; nvm "$@" }
fi

# Ruby
source "${BREW_PREFIX}/opt/chruby/share/chruby/chruby.sh"
source "${BREW_PREFIX}/opt/chruby/share/chruby/auto.sh"

# git-subrepo
source "$HOME/dev/git-subrepo/.rc"

# Disable "interactive comments", so in an interactive shell, commands prefixed
# with a # don't usually lead to a "command not found" error
setopt interactivecomments

# Set up the actual prompt
precmd() {
  setopt extendedglob

  local current_pwd="${PWD/#$HOME/~}"
  local ret_directory

  # Split path components
  local pcs=("${(@s:/:)current_pwd}")
  # Length of array of path components
  local pcs_len="${#pcs[@]}"

  # Number of full path components you want at the end of the path
  local full_pc_len=2

  if [[ "${current_pwd}" == (#m)[/~] ]]; then
    ret_directory="$MATCH"
    unset MATCH
  elif [ ${#pcs[@]} -ge $((full_pc_len + 1)) ]; then
    local path_full_comps=$((pcs_len - full_pc_len))
    local short_path_comps="${(@j:/:M)${pcs[@]:0:$((path_full_comps))}##.#?}"
    local full_path_comps="/${${(@j:/:)${pcs[@]:$((pcs_len - full_pc_len)):$((full_pc_len))}}//\%/%%}"
    ret_directory="${short_path_comps}${full_path_comps}"
  else
    ret_directory="${current_pwd}"
  fi

  unset current_pwd

  PROMPT="%* ${ret_directory}$(prompt_vcs) %F{magenta}❯ %f"
}
